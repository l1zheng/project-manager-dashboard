{
  "name": "@project-manager/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-outlook-script.mjs",
    "test": "vitest run",
    "lint": "eslint src --max-warnings 0",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "seed:demo": "tsx src/seed.ts"
  },
  "dependencies": {
    "@project-manager/domain": "workspace:*",
    "@project-manager/export": "workspace:*",
    "better-sqlite3": "^13.0.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.5.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "drizzle-kit": "^0.31.10"
  }
}
